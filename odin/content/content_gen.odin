	.PickUpShortsword = {text = "You have picked up a shortsword.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsWeaponsShortsword, tutorial_title = "Short Sword (Weapon)", tutorial_text = "A short sword is better than a dagger, but not as good as a long sword."},
	.BrokenShortsword = {text = "You have broken a shortsword.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpLongsword = {text = "You have picked up a longsword.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsWeaponsLongsword, tutorial_title = "Long Sword (Weapon)", tutorial_text = "A long sword is better than a short sword, but not as good as a two handed sword."},
	.BrokenLongsword = {text = "You have broken a longsword.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpTwoHandedSword = {text = "You have picked up a two-handed sword.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsWeaponsTwohandedsword, tutorial_title = "Two Handed Sword (Weapon)", tutorial_text = "A two handed sword is better than a long sword, but not as good as a battle axe. You cannot use a two handed sword with a shield."},
	.BrokenTwoHandedSword = {text = "You have broken a two-handed sword.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpBattleAxe = {text = "You have picked up a battle axe.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsWeaponsBattleaxe, tutorial_title = "Battle Axe (Weapon)", tutorial_text = "A battle axe is the best available weapon."},
	.BrokenBattleAxe = {text = "You have broken a battle axe.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpAmulet = {text = "You have picked up the Amulet of Yendor!", color = .Default, sound = .None, always_tutorial = true, tutorial_image = .MapItemsMiscAmulet, tutorial_title = "Amulet of Yendor (Special)", tutorial_text = "You have picked up the fabled Amulet of Yendor!"},
	.PickUpRainbowKey = {text = "You have picked up the rainbow key.", color = .Default, sound = .None, always_tutorial = true, tutorial_image = .MapItemsKeysRainbow, tutorial_title = "The Rainbow Key (Special)", tutorial_text = "You have picked up the rainbow key!"},
	.PickUpTools = {text = "You have picked up thieves' tools.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsMiscTools, tutorial_title = "Thieves' Tools (Special)", tutorial_text = "You have picked up a set of thieves' tools!  They are useful for disarming traps, or picking your teeth."},
	.PickUpAntidote = {text = "You have picked up a vial of mysterious liquid.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsConsumablesAntidote, tutorial_title = "Antidote (Consumable)", tutorial_text = "You have picked up a vial of mysterious liquid!"},
	.PickUpShield = {text = "You have picked up a shield.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsArmorsShield, tutorial_title = "Shield(Armor)", tutorial_text = "A Shield is worn on your non-weapon hand. It adds 1 to your armor statistic. It cannot be combined with two handed weapons, so will not be in use while you have a two handed weapon while in attack mode.  To change between attack and defend modes, press the Tab key."},
	.BrokenShield = {text = "You have broken a shield.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsArmorsShield, tutorial_title = "Broken Shield(Armor)", tutorial_text = "A shield can only take so many hits and still be effective. The shield you were carrying too one hit too many."},
	.PickUpHelmet = {text = "You have picked up a helmet.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsArmorsHelmet, tutorial_title = "Helmet(Armor)", tutorial_text = "A Helmet is worn on the head. It adds 1 to your armor statistic."},
	.BrokenHelmet = {text = "You have broken a helmet.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpChainmail = {text = "You have picked up a shirt of chainmail.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsArmorsChainmail, tutorial_title = "Chainmail(Armor)", tutorial_text = "Chainmail is worn on the torso, and so cannot be combined with Platemail. It adds 1 to your armor statistic, but also cuts your speed by a quarter."},
	.BrokenChainmail = {text = "You have broken a shirt of chainmail.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpPlatmail = {text = "You have picked up a shirt of platemail.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsArmorsPlatemail, tutorial_title = "Platemail(Armor)", tutorial_text = "This is the heaviest armor in the game.  It is worn on the torso, and so cannot be combined with Chainmail.  It adds 2 to your armor statistic, but also cuts your speed in half."},
	.BrokenPlatemail = {text = "You have broken a shirt of platemail.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpBoots = {text = "You have picked up a pair of boots.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsArmorsBoots, tutorial_title = "Boots(Armor)", tutorial_text = "This is a wonderfully made pair of boots. They make you feel light on your feet. While it doesn't add anything to your armor statistic, it does double your speed."},
	.BrokenBoots = {text = "You have worn out a pair of boots.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpHam = {text = "You have picked up a lovely ham.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsConsumablesHam, tutorial_title = "Ham(Food)", tutorial_text = "This is a lovely ham. If you are at less than full health, you will automatically eat a ham to restore one health point. Think of it like having bonus health points."},
	.UseHam = {text = "You eat some ham to recover strength.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsConsumablesHam, tutorial_title = "Eating Ham", tutorial_text = "Since you started to move with less than full health, you have eaten some ham to help restore strength."},
	.PickUpPotion = {text = "You have picked up a crimson potion.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsConsumablesPotion, tutorial_title = "Potion(Drink)", tutorial_text = "Crimson potions are like extra lives. Whenever your character is about to die, he will drink a potion, which will restore up to 10 health points."},
	.UsePotion = {text = "You quaff a potion in the nick of time, making you good as new.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsConsumablesPotion, tutorial_title = "Drinking a Potion", tutorial_text = "You were about to die. Fortunately, you had a potion handy - this time. Close call!"},
	.PickUpCopper = {text = "You have picked up a pile of copper pieces.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsTreasuresCopper, tutorial_title = "Pile of Copper(Treasure)", tutorial_text = "A pile of copper coins can be worth anywhere from 1 to 5 Gold."},
	.PickUpSilver = {text = "You have picked up a pile of silver pieces.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsTreasuresSilver, tutorial_title = "Pile of Silver(Treasure)", tutorial_text = "A pile of silver coins can be worth anywhere from 6 to 25 Gold."},
	.PickUpGold = {text = "You have picked up a pile of gold pieces.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsTreasuresGold, tutorial_title = "Pile of Gold(Treasure)", tutorial_text = "A pile of gold coins can be worth anywhere from 26 to 50 Gold."},
	.StolenGold = {text = "Gold has been stolen from you.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsTreasuresGold, tutorial_title = "Stolen Gold!", tutorial_text = "Some creatures have a special attack of stealing Gold from you."},
	.PickUpElectrum = {text = "You have picked up a pile of electrum pieces.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsTreasuresElectrum, tutorial_title = "Pile of Electrum(Treasure)", tutorial_text = "A pile of electrum coins can be worth anywhere from 51 to 100 Gold. (And yes, I know that Electrum in D&D was valued in between silver and gold... the picture of bluish coins was bigger than the gold picture. Deal with it!)"},
	.PickUpPlatinum = {text = "You have picked up a pile of platinum pieces.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsTreasuresPlatinum, tutorial_title = "Pile of Platinum(Treasure)", tutorial_text = "A pile of platinum coins can be worth anywhere from 101 to 200 Gold."},
	.PickUpPoisonHam = {text = "You have eaten a poison ham.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsConsumablesHam, tutorial_title = "Poison Ham", tutorial_text = "Some enemies drop poison ham. Eating it will hurt you. However, I believe there is an antidote...."},
	.Welcome1 = {text = "Comfort and safety warning: may cause repetitive stress injury after prolonged play.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.Welcome2 = {text = "Welcome to HamQuest!", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.Welcome3 = {text = "Collect the 16 pieces of the MegaHam, then find the exit!", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.Welcome4 = {text = "You have a small supply of food, a dagger, and a torch, but you will need other items to make it through", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.Welcome5 = {text = "safely! Good luck!", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.DisarmDartTrap = {text = "You use a set of thieves' tools to disarm the dart trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpAmethysts = {text = "You have picked up a small bundle of amethysts.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.KilledByBladeTrap = {text = "You have been killed by a blade trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.GoOutTorch = {text = "Your torch has gone out.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpPlatemail = {text = "You have picked up a suit of platemail.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpClothes = {text = "You have picked up some clothes.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.BrokenClothes = {text = "Your clothes have fallen to rags.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpSapphires = {text = "You have picked up a small bundle of sapphires.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpRubies = {text = "You have picked up a small bundle of rubies.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpEmeralds = {text = "You have picked up a small bundle of emeralds.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpDiamonds = {text = "You have picked up a small bundle of diamonds.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpChest = {text = "You have opened a chest.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.KilledByDartTrap = {text = "You have been killed by a dart trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.KilledByArrowTrap = {text = "You have been killed by an arrow trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.DisarmBladeTrap = {text = "You use a set of thieves' tools to disarm the blade trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpQuest = {text = "You have picked up a piece of the Megaham!", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpExit = {text = "You have found the exit.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
