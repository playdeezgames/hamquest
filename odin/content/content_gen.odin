	.None = {},
	.CannotRest = {text = "You cannot rest while monsters lurk!", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PlayerRest = {text = "You rest a moment to regain your breath.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.DisarmPoisonHam = {text = "You have eaten a poison ham. You drink a vial of green liquid, and suffer no ill effects.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpDartTrap = {text = "You have sprung a dart trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpBladeTrap = {text = "You have sprung a blade trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpArrowTrap = {text = "You have sprung an arrow trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.DartTrap = {text = "You use a set of thieves' tools to disarm the dart trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.BladeTrap = {text = "You use a set of thieves' tools to disarm the blade trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.DisarmArrowTrap = {text = "You use a set of thieves' tools to disarm the arrow trap.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpGemstones = {text = "You pick up a small pile of gemstones.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.PickUpTorch = {text = "You have picked up a torch.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsLightsTorch, tutorial_title = "Torch (Light Source)", tutorial_text = "You have picked up a torch. As light sources go, a torch is not the greatest, but it is better than nothing!"},
	.PickUpLantern = {text = "You have picked up a lantern.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsLightsLantern, tutorial_title = "Lantern (Light Source)", tutorial_text = "You have picked up a lantern. A lantern is much better than a torch for providing light. It also lasts a great deal longer."},
	.PickUpMagicLantern = {text = "You have picked up a torch.", color = .Default, sound = .None, always_tutorial = false, tutorial_image = .MapItemsLightsMagiclantern, tutorial_title = "Magic Lantern (Light Source)", tutorial_text = "You have picked up a magic lantern. It is the best light source you can find. Unfortunately, it is rare."},
	.GainExperiencePoint = {text = "You have gained {0} experience point!", color = .Experience, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.GainExperiencePoints = {text = "You have gained {0} experience points!", color = .Experience, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
	.GainExperienceLevel = {text = "You have gained a new experience level!", color = .Experience, sound = .None, always_tutorial = false, tutorial_image = .None, tutorial_title = "", tutorial_text = ""},
